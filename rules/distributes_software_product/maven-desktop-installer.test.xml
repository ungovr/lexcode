<?xml version="1.0" encoding="UTF-8"?>
<!-- lexcode-expect: 3 -->
<!-- A desktop application's build: native installers with jpackage, a Windows executable
     wrapper with Launch4j, and an IzPack installer. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>fieldnotes-desktop</artifactId>
  <version>1.4.0</version>

  <build>
    <plugins>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.6.5</version>
        <configuration>
          <name>FieldNotes</name>
          <appVersion>1.4.0</appVersion>
          <destination>target/dist</destination>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.akathist.maven.plugins.launch4j</groupId>
        <artifactId>launch4j-maven-plugin</artifactId>
        <version>2.5.1</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.izpack</groupId>
        <artifactId>izpack-maven-plugin</artifactId>
        <version>5.2.3</version>
      </plugin>
    </plugins>
  </build>
</project>
