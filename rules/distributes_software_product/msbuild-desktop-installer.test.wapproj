<!-- A Windows Application Packaging Project that wraps a desktop app in an MSIX package. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>8f2a1c4e-6b7d-4e3a-9c5f-1d2e3f4a5b6c</ProjectGuid>
    <EntryPointProjectUniqueName>..\Ledger\Ledger.csproj</EntryPointProjectUniqueName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ledger\Ledger.csproj" />
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
</Project>
