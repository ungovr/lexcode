{
    "name": "acme/intranet",
    "type": "project",
    "description": "The intranet the Acme office runs for its own staff",
    "license": "proprietary",
    "repositories": [
        {
            "name": "local-tools",
            "type": "path",
            "url": "../tools"
        },
        {
            "type": "package",
            "package": {
                "name": "legacy/calendar-widget",
                "version": "1.4.0",
                "type": "library",
                "dist": {
                    "url": "https://example.com/calendar-widget-1.4.0.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "legacy/calendar-widget": "1.4.0",
        "symfony/framework-bundle": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
