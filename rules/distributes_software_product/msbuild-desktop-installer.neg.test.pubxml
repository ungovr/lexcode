<?xml version="1.0" encoding="utf-8"?>
<!-- lexcode-expect: 0 -->
<!-- The publish profile of a web app the operator deploys to its own server (Web Deploy, then a
     folder copy). Deploying one's own service is not distributing software. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishUrl>bin\Release\net10.0\publish\</PublishUrl>
    <MSDeployServiceURL>deploy.contoso.example</MSDeployServiceURL>
    <DeployIisAppPath>storefront</DeployIisAppPath>
  </PropertyGroup>
</Project>
