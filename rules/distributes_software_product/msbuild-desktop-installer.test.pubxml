<?xml version="1.0" encoding="utf-8"?>
<!-- lexcode-expect: 1 -->
<!-- The ClickOnce publish profile of a WPF app, installed and updated from a download site. -->
<Project>
  <PropertyGroup>
    <ApplicationRevision>14</ApplicationRevision>
    <ApplicationVersion>3.2.0.*</ApplicationVersion>
    <Configuration>Release</Configuration>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <InstallUrl>https://downloads.contoso.example/ledger/</InstallUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
  </PropertyGroup>
</Project>
