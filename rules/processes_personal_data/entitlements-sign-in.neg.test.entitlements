<?xml version="1.0" encoding="UTF-8"?>
<!-- lexcode-expect: 0 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links and Handoff open pages; they sign nobody in. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:example.com</string>
		<string>activitycontinuation:example.com</string>
	</array>
	<!-- A webcredentials string in another key's array is not an associated domain. -->
	<key>com.example.migration-notes</key>
	<array>
		<string>webcredentials:old.example.com</string>
	</array>
	<!-- Sign in with Apple, switched off: the capability with no value. -->
	<key>com.apple.developer.applesignin</key>
	<array/>
	<!-- Apple Pay and push notifications. -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.com.example</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.webcredentials</string>
	</array>
</dict>
</plist>
